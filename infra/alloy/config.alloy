logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "checkout_api_logs" {
  targets = discovery.docker.local.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "checkout-api"
    action        = "keep"
  }
}

loki.source.docker "checkout_api" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.checkout_api_logs.output
  forward_to = [loki.process.checkout_api.receiver]
}

loki.process "checkout_api" {
  stage.docker {}

  stage.json {
    expressions = {
      environment = "environment",
      level       = "level",
      service     = "service",
    }
  }

  stage.labels {
    values = {
      environment = "",
      level       = "",
      service     = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

otelcol.receiver.otlp "application" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs    = [otelcol.processor.transform.application_identity.input]
    metrics = [otelcol.processor.transform.application_identity.input]
  }
}

otelcol.processor.transform "application_identity" {
  error_mode = "ignore"

  log_statements {
    context = "resource"
    statements = [
      `set(resource.attributes["service"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil`,
      `set(resource.attributes["environment"], resource.attributes["deployment.environment.name"]) where resource.attributes["deployment.environment.name"] != nil`,
    ]
  }

  metric_statements {
    context = "datapoint"
    statements = [
      `set(datapoint.attributes["service"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil`,
      `set(datapoint.attributes["environment"], resource.attributes["deployment.environment.name"]) where resource.attributes["deployment.environment.name"] != nil`,
    ]
  }

  output {
    logs    = [otelcol.processor.attributes.loki_labels.input]
    metrics = [otelcol.processor.batch.application.input]
  }
}

otelcol.processor.attributes "loki_labels" {
  action {
    key    = "loki.resource.labels"
    action = "insert"
    value  = "service, environment"
  }

  output {
    logs = [otelcol.processor.batch.application.input]
  }
}

otelcol.processor.batch "application" {
  output {
    logs    = [otelcol.exporter.loki.application.input]
    metrics = [otelcol.exporter.prometheus.application.input]
  }
}

otelcol.exporter.loki "application" {
  forward_to = [loki.write.local.receiver]
}

otelcol.exporter.prometheus "application" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
