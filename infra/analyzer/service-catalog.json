{
  "schemaVersion": 1,
  "services": {
    "checkout-api": {
      "criticality": "high",
      "environments": {
        "local": {
          "severityCeiling": "critica",
          "impactQueries": {
            "totalRequests": "checkout_requests_total{service=\"{{service}}\",environment=\"{{environment}}\"}",
            "failedRequests": "checkout_requests_total{service=\"{{service}}\",environment=\"{{environment}}\",outcome=\"failure\"}",
            "availability": "checkout_availability{service=\"{{service}}\",environment=\"{{environment}}\"}"
          }
        }
      }
    },
    "connect-api": {
      "criticality": "medium",
      "environments": {
        "local": {
          "severityCeiling": "alta",
          "impactQueries": {
            "totalRequests": "http_server_requests_total{service=\"{{service}}\",environment=\"{{environment}}\"}",
            "failedRequests": "http_server_requests_total{service=\"{{service}}\",environment=\"{{environment}}\",outcome=\"failure\"}"
          }
        }
      }
    }
  }
}
