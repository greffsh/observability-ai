{
  "schemaVersion": 1,
  "services": {
    "checkout-api": {
      "criticality": "high",
      "environments": {
        "local": {
          "severityCeiling": "critica",
          "impactQueries": {
            "totalRequests": "checkout_requests_total{service=\"{{service}}\",environment=\"{{environment}}\"}",
            "failedRequests": "checkout_requests_total{service=\"{{service}}\",environment=\"{{environment}}\",outcome=\"failure\"}",
            "failureState": "checkout_failure_mode{service=\"{{service}}\",environment=\"{{environment}}\"}",
            "availability": "checkout_availability{service=\"{{service}}\",environment=\"{{environment}}\"}",
            "lastChange": "checkout_last_change_timestamp_seconds{service=\"{{service}}\",environment=\"{{environment}}\"}"
          }
        }
      }
    },
    "connect": {
      "criticality": "medium",
      "environments": {
        "local": {
          "severityCeiling": "alta",
          "impactQueries": {
            "totalRequests": "connect_http_requests_total{service=\"{{service}}\",environment=\"{{environment}}\"}",
            "failedRequests": "connect_http_requests_total{service=\"{{service}}\",environment=\"{{environment}}\",outcome=\"failure\"}",
            "failureState": "connect_failure_state{service=\"{{service}}\",environment=\"{{environment}}\"}",
            "availability": "connect_availability{service=\"{{service}}\",environment=\"{{environment}}\"}",
            "lastChange": "connect_last_change_timestamp_seconds{service=\"{{service}}\",environment=\"{{environment}}\"}"
          }
        }
      }
    }
  }
}
